{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvokeRegionalModels",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-2::foundation-model/amazon.nova-lite-v1:0",
        "arn:aws:bedrock:us-east-2::foundation-model/amazon.titan-embed-text-v2:0"
      ]
    },
    {
      "Sid": "InvokeClaudeThroughTheUsInferenceProfile",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "arn:aws:bedrock:us-east-2:<ACCOUNT_ID>:inference-profile/us.anthropic.claude-sonnet-5-5"
    },
    {
      "Sid": "ClaudeModelsOnlyViaThatProfile",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:us-east-1::foundation-model/anthropic.claude-sonnet-5-5",
        "arn:aws:bedrock:us-east-2::foundation-model/anthropic.claude-sonnet-5-5",
        "arn:aws:bedrock:us-west-2::foundation-model/anthropic.claude-sonnet-5-5"
      ],
      "Condition": {
        "StringEquals": {
          "bedrock:InferenceProfileArn": "arn:aws:bedrock:us-east-2:<ACCOUNT_ID>:inference-profile/us.anthropic.claude-sonnet-5-5"
        }
      }
    },
    {
      "Sid": "ConverseAuthorizedGuardrails",
      "Effect": "Allow",
      "Action": "bedrock:ApplyGuardrail",
      "Resource": "arn:aws:bedrock:us-east-2:<ACCOUNT_ID>:guardrail/*"
    },
    {
      "Sid": "ConverseAuthorizedSystemTools",
      "Effect": "Allow",
      "Action": "bedrock:InvokeTool",
      "Resource": "arn:aws:bedrock::<ACCOUNT_ID>:system-tool/*"
    },
    {
      "Sid": "ReadTheDatabaseConnectionSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-2:<ACCOUNT_ID>:secret:nautilm/database-??????"
    },
    {
      "Sid": "ReadNautilmProviderSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:us-east-2:<ACCOUNT_ID>:secret:nautilm/providers/*"
    },
    {
      "Sid": "ConverseAuthorizedBearerToken",
      "Effect": "Allow",
      "Action": "bedrock:CallWithBearerToken",
      "Resource": "*"
    }
  ]
}
